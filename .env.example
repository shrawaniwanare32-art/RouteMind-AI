# Copy to .env for local use. NEVER commit the real .env.
# The app itself needs none of these; they are for the deployment scripts / CI.

# --- app (all optional) ---
API_URL=http://localhost:8000
ROUTEMIND_AUTO_TRAIN=true
# ROUTEMIND_HOME=/data              # move data/, artifacts/, logs/ elsewhere

# --- AWS (use GitHub secrets / OIDC in CI, never commit these) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- Azure ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
